            findings.append(f)

    if not findings:
        print("[!] Tidak ada data di findings.xlsx")
        return

    print(f"\n[*] {len(findings)} clone di findings.xlsx:")
    for i, f in enumerate(findings, 1):
        print(f"  [{i}] {f.url}")

    idx_input = prompt("Pilih nomor clone (Enter = semua)", "semua")
    if idx_input.lower() == "semua":
