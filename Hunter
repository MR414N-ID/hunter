        if row[1]:
            f = Finding(
                url        = str(row[1]),
                score      = row[2] or 0,
                similarity = row[3] or 0.0,
                server_ip  = row[4] or "",
                title      = row[5] or "",
                sent_form  = row[6] or 0,
                sent_raw   = row[7] or 0,
                sent_comment = row[8] or 0,
                sent_gform = row[9] or 0,
                last_sent  = row[11] or "",
