            print("[!] Input tidak valid.")
            return

    message = prompt("Pesan (Enter = default)", DEFAULT_MSG)

    _stop.clear()
    for target in targets:
        if _stop.is_set():
            break
        flood_target(target, message, XLSX_FILE)

